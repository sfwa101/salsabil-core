# نسخ هذا الملف إلى .env.local (مُستثنى من Git عبر .gitignore، لا تُلصق قيماً حقيقية هنا)
# القيم الثلاث من إعدادات مشروع Supabase: Project Settings → API

# رابط مشروع Supabase — عام (NEXT_PUBLIC_*)، يصل للمتصفح
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# مفتاح anon العام — للقراءة العامة فقط (categories/products/inventory)، يصل للمتصفح
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح service_role — يتجاوز RLS بالكامل، خادم فقط (حزمة server-only تمنع تسرّبه لأي Client
# Component وقت البناء). لا تضعه أبداً خلف NEXT_PUBLIC_. راجع docs/DATABASE.md §1، ADR-008.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# OTP — ادّعاء حساب عميل + مسارات تحقق مستقبلية (ADR-030) — src/core/kernel/otp/
# القناة الأساسية WhatsApp (Meta Cloud API مباشرة). كلتا القناتين اختياريتان في الكود
# (otpService.sendChallenge يتخطّى أي قناة env ناقصة) — لكن بلا أي قناة مُعدَّة، كل إرسال يفشل
# صراحة (Fail Closed)، لا نجاح وهمي.
# ============================================================================

# WhatsApp Business Platform — Meta for Developers → App → WhatsApp → API Setup
# WHATSAPP_PHONE_NUMBER_ID: معرّف رقم المُرسِل (لا رقم الهاتف نفسه)
# WHATSAPP_ACCESS_TOKEN: System User Access Token دائم (لا Token مؤقت 24 ساعة لتطوير فقط)
# WHATSAPP_OTP_TEMPLATE_NAME: اسم قالب Authentication المعتمَد فعلياً من Meta — لا يعمل بلا موافقة
# WHATSAPP_OTP_TEMPLATE_LANG: كود اللغة المعتمَد مع القالب (افتراضي "ar" إن لم يُضبَط)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token-here
WHATSAPP_OTP_TEMPLATE_NAME=your-approved-template-name-here
WHATSAPP_OTP_TEMPLATE_LANG=ar

# SMS Misr (sms.com.eg) — Fallback فقط، لا القناة الأساسية. ⚠️ عقد API هنا غير مؤكَّد رسمياً
# (راجع تعليق src/core/kernel/otp/sms-misr-channel.ts) — تحقَّق قبل الاعتماد عليه في إنتاج حقيقي.
SMS_MISR_USERNAME=your-sms-misr-username-here
SMS_MISR_PASSWORD=your-sms-misr-password-here
SMS_MISR_SENDER=your-approved-sender-token-here
